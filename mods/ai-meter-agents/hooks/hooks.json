{
  "description": "Record each session's state for the ai-meter board's Agents page",
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_state.py\"", "timeout": 5 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_state.py\"", "timeout": 5 }] }],
    "PreToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_state.py\"", "timeout": 5 }] }],
    "PostToolUse": [{ "matcher": "*", "hooks": [{ "type": "command", "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_state.py\"", "timeout": 5 }] }],
    "Notification": [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_state.py\"", "timeout": 5 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_state.py\"", "timeout": 5 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "/usr/bin/python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_state.py\"", "timeout": 5 }] }]
  }
}
